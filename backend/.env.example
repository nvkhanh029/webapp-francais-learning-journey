# Copy to .env, then generate your own value with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Never commit .env or a real secret.
SECRET_KEY=

# Optional. Set to 1 when the app is served over HTTPS behind a TLS-terminating
# proxy so the session cookie gets the Secure flag. Direct HTTPS requests are
# detected automatically; leave unset for local HTTP development.
# SESSION_COOKIE_SECURE=1
